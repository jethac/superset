# Only install package versions that have been on the registry for at least
# this many days, mirroring the 7-day `cooldown` in .github/dependabot.yml so
# the same quarantine applies to developer and CI installs, not just to
# Dependabot pull requests. `min-release-age` requires npm >= 11.13.0,
# the version pinned in superset-frontend/package.json `engines`.
min-release-age=7
