# Apply the same 7-day cooldown that .github/dependabot.yml gives Dependabot to
# every install run from this directory. Versions published less than 7 days
# ago are invisible to the resolver, which is the window in which most
# malicious npm releases are found and yanked.
#
# Needs npm >= 11.10.0; older npm ignores the key without erroring. Versions
# already pinned in package-lock.json are unaffected, so `npm ci` installs
# exactly what the lockfile resolves.
min-release-age=7
